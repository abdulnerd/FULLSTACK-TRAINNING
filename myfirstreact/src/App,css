body {
  margin: 0;
  font-family: Arial;
  background-color: #f2f2f2;
}

.dashboard {
  padding: 25px;
}

.dashboard h1 {
  color: #222;
}

.cards {
  display: flex;
  gap: 20px;
  margin-top: 25px;
  margin-bottom: 30px;
}

.card {
  background-color: white;
  padding: 20px;
  width: 200px;
  border-radius: 8px;
  text-align: center;
  box-shadow: 0 2px 5px gray;
}

.card h2 {
  color: blue;
}

.dashboard p {
  font-size: 16px;
}